---
title: "Contatti"
summary: "Una pagina di contatti per LangAmore, una guest house in Piemonte."
url: "https://langamorepollenzo/contact"

import BaseLayout from "../layouts/baseLayout.astro"
---

<BaseLayout title="Contatti | LangAmore">
    <style>
        .contact-container {
            background-color: #ffffff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            width: 100%;
            max-width: 960px;
        }
        .contact-info {
            text-align: center;
        }
        .contact-info h2 {
            color: #1f2937; /* gray-800 */
        }
        .contact-info p {
            font-size: 1.1rem;
            color: #374151; /* gray-700 */
        }
        .contact-info a {
            color: #1d4ed8; /* blue-700 */
            text-decoration: none;
            font-weight: 600;
        }
        .contact-info a:hover {
            text-decoration: underline;
        }
        .map-container {
            margin-top: 2rem;
            border-radius: 0.75rem;
            overflow: hidden;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        }
        .cta-row {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }
        @media (min-width: 640px) {
            .cta-row { grid-template-columns: repeat(3, 1fr); }
        }
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            border-radius: 9999px;
            font-weight: 600;
            text-decoration: none;
            transition: all 200ms ease;
        }
        .btn-primary { background: #2563eb; color: #fff; }
        .btn-primary:hover { background: #1d4ed8; }
        .btn-outline { border: 2px solid #2563eb; color: #2563eb; }
        .btn-outline:hover { background: #eff6ff; }
        .btn-ghost { color: #2563eb; }
        .btn-ghost:hover { text-decoration: underline; }
    </style>

    <main class="flex flex-col items-center px-4 py-6 sm:px-6 lg:px-8">
        <div class="contact-container">
            <h1 class="text-4xl font-extrabold mb-2 text-center text-gray-800">Contatti</h1>
            <p class="text-center text-gray-600 mb-6">Scrivici per verificare disponibilità o per qualsiasi informazione.</p>

            <div class="contact-info m-8">
                <h3 class="text-xl font-bold">LangAmore si trova in:</h3>
                <p>Via Regina Margherita, 6</p>
                <p>12042 Pollenzo (CN)</p>
            </div>

            <div class="contact-info">
                <p>Telefono: <a href="tel:+393331645850">Elisa: +39 333 164 5850</a></p>
                <p>Invia un'email a LangAmore: 
                    <a href="mailto:c.elisacravero@yahoo.it">
                        c.elisacravero@yahoo.it
                    </a>
                </p>
            </div>

            <div class="cta-row">
                <a href="tel:+393331645850" class="btn btn-primary" title="Chiama ora">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M2.25 6.75c0-1.243 1.007-2.25 2.25-2.25h2.123c.98 0 1.84.63 2.12 1.566l.65 2.166a2.25 2.25 0 01-.564 2.238l-1.21 1.21a14.978 14.978 0 006.06 6.06l1.21-1.21a2.25 2.25 0 012.238-.564l2.165.65a2.25 2.25 0 011.567 2.12V19.5a2.25 2.25 0 01-2.25 2.25H18c-8.284 0-15-6.716-15-15V6.75z"/></svg>
                    Chiama ora
                </a>
                <a href="https://wa.me/393331645850" target="_blank" rel="noopener" class="btn btn-outline" title="Scrivici su WhatsApp">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M20.52 3.48A11.86 11.86 0 0012.06 0C5.49 0 .16 5.33.16 11.9c0 2.1.55 4.14 1.59 5.95L0 24l6.33-1.66a11.86 11.86 0 005.73 1.47h.01c6.56 0 11.89-5.33 11.89-11.9 0-3.18-1.24-6.17-3.44-8.43zm-8.46 18.3h-.01a9.87 9.87 0 01-5.02-1.37l-.36-.21-3.76.99 1-3.66-.24-.38a9.88 9.88 0 01-1.52-5.29c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 012.9 7c0 5.45-4.44 9.9-9.9 9.9zm5.55-7.39c-.3-.15-1.76-.86-2.03-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.14-.17.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.48-1.77-1.65-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.5-.17 0-.37-.02-.57-.02-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.49 1.07 2.88 1.22 3.08c.15.2 2.1 3.21 5.08 4.5.71.31 1.27.5 1.7.64.72.23 1.38.2 1.9.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.11-.27-.2-.57-.35z"/></svg>
                    Scrivici su WhatsApp
                </a>
                <a href="mailto:c.elisacravero@yahoo.it" class="btn btn-ghost" title="Invia Email">Invia Email</a>
            </div>

            <div class="map-container w-full h-64 sm:h-80 lg:h-96 mt-8">
                <iframe 
                    class="w-full h-full"
                    src="https://www.google.com/maps/embed/v1/place?q=Via+Regina+Margherita,+6,+12042+Pollentia,+Bra+Province+of+Cuneo,+Italia&key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8" 
                    allowfullscreen="" 
                    loading="lazy">
                </iframe>
            </div>
        </div>
    </main>
</BaseLayout>
