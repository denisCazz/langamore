        left: 1rem; /* allineato con px-3 */
        right: 1rem;
        bottom: 0.75rem; /* poco sopra il bordo */
        height: 2px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 200ms ease;
        opacity: 0.7;
    }
    .group:hover::after, .group:focus-visible::after {
        transform: scaleX(1);
    }
</style>
